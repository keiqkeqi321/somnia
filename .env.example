# Deploy target (scripts/deploy-remote.sh)
DEPLOY_USER=root
DEPLOY_HOST=47.109.202.44

# Python on the server used for pip install (must be >= 3.11)
SERVER_PYTHON=python3.11

# Relay bootstrap admin account (first --setup only; never overwrites an
# existing account's password)
SOMNIA_ADMIN_USERNAME=admin
SOMNIA_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional overrides
# SERVER_NAME=47.109.202.44        # public origin without scheme
# WEB_DIR=/var/www/somnia
# DATA_DIR=/var/lib/somnia
# TLS_CERT=/etc/nginx/certs/somnia.crt
# TLS_KEY=/etc/nginx/certs/somnia.key
